generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// Organizations & Shops (Multi-Tenancy)
// --------------------------------------------------------

model Organization {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  ownerName    String?
  contactEmail String?
  contactPhone String?
  logoType     String   @default("text") // 'image' or 'text'
  logoUrl      String?
  status       String   @default("active") // active, suspended, deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shops        Shop[]
  users        User[]
  products     Product[]
  categories   Category[]
  customers    Customer[]
  suppliers    Supplier[]
  bills        Bill[]
  transactions Transaction[]
}

model Shop {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  code      String?
  address   String?
  phone     String?
  gstNumber String?
  status    String   @default("active") // active, inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  inventory    Inventory[]
  bills        Bill[]
  transactions Transaction[]
}

// --------------------------------------------------------
// Users & Roles
// --------------------------------------------------------

enum Role {
  SUPERADMIN
  ORG_OWNER
  MANAGER
  CASHIER
  STAFF
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  status       String   @default("active") // active, inactive, deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bills        Bill[]
  transactions Transaction[]
}

// --------------------------------------------------------
// Inventory & Products
// --------------------------------------------------------

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name          String
  sku           String?
  barcode       String?
  description   String?
  unit          String  @default("pcs")
  sellingPrice  Float   @default(0)
  costPrice     Float   @default(0)
  taxRate       Float   @default(0)
  isRawMaterial Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory   Inventory[]
  billItems   BillItem[]
  recipeItems RecipeItem[]
}

model Inventory {
  id        String  @id @default(uuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity     Float @default(0)
  minThreshold Float @default(0)

  updatedAt DateTime @updatedAt

  @@unique([shopId, productId])
}

// --------------------------------------------------------
// Production & Recipes
// --------------------------------------------------------

model RecipeItem {
  id             String  @id @default(uuid())
  finishedGoodId String
  rawMaterialId  String
  rawMaterial    Product @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  quantityNeeded Float
}

// --------------------------------------------------------
// Customers & Suppliers
// --------------------------------------------------------

enum PartyType {
  CUSTOMER
  SUPPLIER
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  address   String?
  gstNumber String?
  type      PartyType @default(CUSTOMER)

  balance Float @default(0) // Ledger balance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills        Bill[]
  transactions Transaction[]
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  address   String?
  gstNumber String?

  balance Float @default(0) // Ledger balance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

// --------------------------------------------------------
// Billing & POS
// --------------------------------------------------------

model Bill {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  billNumber     String
  totalAmount    Float
  taxAmount      Float
  discountAmount Float  @default(0)
  finalAmount    Float
  paymentMode    String // CASH, CARD, UPI, CREDIT
  status         String @default("COMPLETED") // COMPLETED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        BillItem[]
  transactions Transaction[]
}

model BillItem {
  id        String  @id @default(uuid())
  billId    String
  bill      Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Float
  price       Float
  taxAmount   Float @default(0)
  totalAmount Float
}

// --------------------------------------------------------
// Finance & Ledger Transactions
// --------------------------------------------------------

model Transaction {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId         String?
  shop           Shop?        @relation(fields: [shopId], references: [id])

  type        String // PAYMENT_IN, PAYMENT_OUT, SALES, EXPENSE
  amount      Float
  paymentMode String
  reference   String?
  notes       String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  billId String?
  bill   Bill?   @relation(fields: [billId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
